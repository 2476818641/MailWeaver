# MailWeaver DIY 邮件服务器配置示例
# 复制此文件为 .env 并修改配置项

# --- 服务器配置 ---
# 服务器的完全限定域名 (FQDN)
SERVER_HOSTNAME=mail.example.com

# --- Let's Encrypt 配置 ---
# 用于申请 SSL 证书的邮箱地址
LETS_ENCRYPT_EMAIL=admin@example.com

# --- Cloudflare API 配置 (用于 DNS 验证) ---
# Cloudflare 登录邮箱
CF_Email=your-cloudflare-email@example.com

# Cloudflare Global API Key
# 获取路径: Cloudflare Dashboard -> My Profile -> API Tokens -> Global API Key
CF_Key=your-cloudflare-global-api-key

# --- MariaDB 数据库配置 ---
# 数据库 root 密码 (至少 12 位，包含大小写字母、数字和特殊字符)
MYSQL_ROOT_PASSWORD=YourStrongRootPassword123!

# 邮件数据库名称
DB_NAME=mailserver

# 邮件数据库用户名
DB_USER=mailadmin

# 邮件数据库用户密码 (至少 12 位，包含大小写字母、数字和特殊字符)
DB_PASS=YourStrongDatabasePassword123!

# URL 编码后的数据库密码 (由安装脚本自动生成，通常不需要手动设置)
DB_PASS_ENCODED=

# --- ViMbAdmin 配置 ---
# ViMbAdmin DES_KEY (24 位随机字符串，由安装脚本自动生成)
DES_KEY=

# ViMbAdmin 超级管理员密码 (至少 12 位，包含大小写字母、数字和特殊字符)
VIMBADMIN_ADMIN_PASS=YourStrongAdminPassword123!

# --- 虚拟邮件用户配置 ---
# 虚拟邮件用户 UID (默认: 205)
VMAIL_UID=205

# 虚拟邮件用户 GID (默认: 205)
VMAIL_GID=205

# --- 安全提示 ---
# 1. 所有密码都应该足够强壮
# 2. 不要将包含敏感信息的 .env 文件提交到版本控制系统
# 3. 文件权限应设置为 600 (仅所有者可读写)
# 4. Cloudflare API Key 具有完全访问权限，请妥善保管